{
	"layer": "top",
	"position": "top",
	"margin-top": 0,
	"margin-bottom": 0,
	"margin-left": 0,
	"margin-right": 0,
	"height": 24,
	"modules-left": ["custom/desktop", "hyprland/workspaces", "cava"],
	"modules-center": ["hyprland/window"],
	"modules-right": ["custom/logout", "battery", "clock"],
	"custom/desktop": {
		"format": "    ",
		"tooltip": false,
		"on-click": "hyprland_desktop"
	},
	"custom/logout": {
		"format": " ⏻ ",
		"tooltip": false,
		"on-click": "hyprland_shutdown_menu"
	},
	"hyprland/workspaces": {
		"format": "{name}",
		"on-click": "activate",
		"all-outputs": true
	},
	"cava": {
		"framerate": 20,
		"autosens": 1,
		"sensitivity": 1,
		"bars": 8,
		"lower_cutoff_freq": 50,
		"higher_cutoff_freq": 20000,
		"method": "pulse",
		"source": "auto",
		"stereo": true,
		"reverse": false,
		"bar_delimiter": 0,
		"monstercat": false,
		"waves": false,
		"noise_reduction": 0.20,
		"input_delay": 2,
		"format-icons" : [" ", " ", "▁", "▂", "▃", "▄", "▅", "▆"],
		"actions": {
			"on-click-right": "mode"
		}
	},
	"hyprland/window": {
		"format": "{title}",
		"tooltip": true,
		"separate-outputs": true
	},
	//"wireplumber": {
	//	"format": " 🔊 {volume}% ",
	//	"on-click": "pavucontrol"
	//},
	"battery": {
		"bat": "BAT0",
		"interval": 60,
		"format": " 🔋{capacity}% ",
		"max-length": 25
	},
	"clock": {
		"format": " {:%H:%M} ",
		"on-click": "hyprland_clock"
	}
}
